# ==============================================================================
# LabRox Enterprise LIMS (labrox-api) - Environment Variables Baseline
# 21 CFR Part 11 Compliant Infrastructure Configuration
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=labrox_lims
POSTGRES_USER=labrox_admin
POSTGRES_PASSWORD=replace_with_secure_production_password_min_16_chars

# Redis Cache & Session Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_redis_auth_token

# MinIO / S3 Document & Report Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=labrox_minio
MINIO_ROOT_PASSWORD=replace_with_secure_minio_secret_key
MINIO_BUCKET_REPORTS=labrox-clinical-reports

# Authentication & JWT Security (Argon2id + HMAC-SHA512)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970_REPLACE_IN_PROD
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Gateway Routing
GATEWAY_PORT=8088
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
